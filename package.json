{
  "name": "sanity-test",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p ${PORT:-4040}",
    "build": "rm -rf .next/cache/fetch-cache && next build",
    "start": "next start -H 127.0.0.1 -p ${PORT:-4040}",
    "prod": "npm run build && next start -H 127.0.0.1 -p ${PORT:-4040}",
    "studio": "SANITY_STUDIO_STANDALONE=true sanity dev",
    "deploy:studio": "SANITY_STUDIO_STANDALONE=true SANITY_STUDIO_HOSTED=true sanity deploy",
    "seed": "sanity exec scripts/seed.ts --with-user-token --",
    "cleanup:legacy": "sanity exec scripts/cleanup-legacy.ts --with-user-token",
    "touch": "sanity exec scripts/touch.ts --with-user-token --",
    "typegen": "sanity schemas extract --force && sanity typegen generate",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "engine": "tsx --env-file=engine/.env.local engine/src/main.ts",
    "engine:setup": "tsx --env-file=engine/.env.local engine/src/workspace/setup.ts",
    "migrate:admin": "sanity exec scripts/migrate-admin.ts --with-user-token --"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.283",
    "@anthropic-ai/sdk": "^0.128.0",
    "@next/third-parties": "^16.3.6",
    "@portabletext/editor": "^8.2.1",
    "@sanity/client": "^8.7.0",
    "@sanity/icons": "^5.2.2",
    "@sanity/image-url": "^2.1.1",
    "@sanity/vision": "^6.16.0",
    "fractional-indexing": "^4.0.0",
    "jose": "^6.2.12",
    "motion": "^13.4.4",
    "next": "16.3.6",
    "next-sanity": "^13.3.4",
    "pixelmatch": "^7.2.0",
    "playwright-core": "^1.63.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.23",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanity": "^6.16.0",
    "sanity-plugin-media": "^6.3.0",
    "server-only": "^0.0.1",
    "styled-components": "^6.5.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.4",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jsdom": "^30.1.1",
    "sharp": "^0.35.4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.2"
  }
}
