{
  "name": "sanity-test",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p ${PORT:-4040}",
    "build": "rm -rf .next/cache/fetch-cache && next build",
    "start": "next start -H 127.0.0.1 -p ${PORT:-4040}",
    "prod": "npm run build && next start -H 127.0.0.1 -p ${PORT:-4040}",
    "studio": "SANITY_STUDIO_STANDALONE=true sanity dev",
    "deploy:studio": "SANITY_STUDIO_STANDALONE=true SANITY_STUDIO_HOSTED=true sanity deploy",
    "seed": "sanity exec scripts/seed.ts --with-user-token",
    "touch": "sanity exec scripts/touch.ts --with-user-token --",
    "typegen": "sanity schemas extract --force && sanity typegen generate",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@sanity/client": "^8.7.0",
    "@sanity/icons": "^5.2.2",
    "@sanity/image-url": "^2.1.1",
    "@sanity/vision": "^6.16.0",
    "next": "16.3.6",
    "next-sanity": "^13.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanity": "^6.16.0",
    "sanity-plugin-media": "^6.3.0",
    "server-only": "^0.0.1",
    "styled-components": "^6.5.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "sharp": "^0.35.4",
    "typescript": "^5"
  }
}
