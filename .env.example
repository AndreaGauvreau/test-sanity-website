# Copier en .env.local

# Projet et dataset Sanity (publics : ils apparaissent dans les URL d'API)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Mêmes valeurs pour l'admin lancé hors de Next (npm run studio / deploy:studio)
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

# Token « viewer » (lecture seule) : brouillons dans l'aperçu live et en Draft Mode.
# npx sanity tokens create "Next.js preview" --role viewer
SANITY_API_READ_TOKEN=

# Mise à jour live après publication :
#   (vide)  updateTag → les pages ouvertes se mettent à jour en quelques secondes
#   swr     revalidateTag(tag, 'max') → comportement par défaut de next-sanity 13
SANITY_LIVE_MODE=

# Google Tag Manager (GTM-KK83GHRF → GA4 G-DE4VPDJ8CS) : chargé automatiquement sur le
# déploiement de production Vercel. `true` pour le tester en local (build de prod).
ENABLE_ANALYTICS=
