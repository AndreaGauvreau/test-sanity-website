# Copier en .env.local

# Projet et dataset Sanity (publics : ils apparaissent dans les URL d'API)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Mêmes valeurs pour l'admin lancé hors de Next (npm run studio / deploy:studio)
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

# Token « viewer » (lecture seule) : brouillons dans l'aperçu live et en Draft Mode.
# npx sanity tokens create "Next.js preview" --role viewer
SANITY_API_READ_TOKEN=

# Mise à jour live après publication :
#   (vide)  updateTag → les pages ouvertes se mettent à jour en quelques secondes
#   swr     revalidateTag(tag, 'max') → comportement par défaut de next-sanity 13
SANITY_LIVE_MODE=

# Google Tag Manager (GTM-KK83GHRF → GA4 G-DE4VPDJ8CS) : chargé automatiquement sur le
# déploiement de production Vercel. `true` pour le tester en local (build de prod).
ENABLE_ANALYTICS=

# ── Admin (/admin) et moteur IA — voir docs/admin/ARCHITECTURE.md § 9 ──
# URL publique du site (manifeste de l'admin, « View site ↗ ») ; repli http://127.0.0.1:4040
NEXT_PUBLIC_SITE_URL=
# Jeton robot Sanity (rôle Editor) : écritures du moteur IA ; côté admin, seulement en session de dev
# npx sanity tokens create "Admin + moteur IA" --role editor
SANITY_API_WRITE_TOKEN=
# Session de l'admin (32 octets aléatoires en hex) : openssl rand -hex 32
ADMIN_SESSION_SECRET=
# Développement seulement : session sans connexion Sanity (kuartz | client | editor). Jamais en production.
ADMIN_DEV_AUTOLOGIN=
# Moteur IA (processus séparé, npm run engine) et secret partagé (le même dans engine/.env.local)
ENGINE_URL=http://127.0.0.1:4043
ENGINE_SECRET=
# Revalidation du cache du site après publication (POST /api/revalidate, en-tête x-kz-revalidate)
REVALIDATE_SECRET=
# Aperçu de l'éditeur IA seulement (serveur 4042 lancé par le moteur, jamais sur le site public)
# KZ_EDITOR_PREVIEW=1
# ENGINE_PREVIEW_SECRET=
# ADMIN_ORIGIN=http://127.0.0.1:4040

# Lien « ↗ Kuartz hub » en bas de la sidebar (Kuartz seulement), http(s)
KUARTZ_HUB_URL=
