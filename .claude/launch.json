{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "sanity-test",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 4040
    },
    {
      "name": "sanity-test-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "prod"],
      "port": 4040
    },
    {
      "name": "sanity-test-analytics",
      "runtimeExecutable": "env",
      "runtimeArgs": ["ENABLE_ANALYTICS=true", "PORT=4041", "npm", "run", "prod"],
      "port": 4041
    }
  ]
}
